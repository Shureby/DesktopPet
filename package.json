{
  "name": "desktoppet",
  "private": true,
  "version": "0.37.1",
  "type": "module",
  "scripts": {
    "product": "node scripts/apply-product-config.mjs",
    "dev": "vite",
    "build": "npm run product && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sprites": "node scripts/render-sprites.mjs",
    "icon": "node scripts/render-sprites.mjs --icon && tauri icon build/icon-source.png",
    "tauri": "tauri",
    "set-version": "node scripts/version.mjs",
    "test-checklist": "node scripts/test-checklist.mjs",
    "e2e": "node --test --test-concurrency=1 \"e2e/*.test.mjs\"",
    "e2e:long": "node --test \"e2e/long/*.test.mjs\""
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^22.0.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.1",
    "vitest": "^4.1.10",
    "webdriverio": "^9.32.0"
  }
}
